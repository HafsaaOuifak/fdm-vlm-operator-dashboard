# Copy this file to ".env" and fill in ONE option. Never commit ".env".

# Option A: OpenAI directly (platform.openai.com)
OPENAI_API_KEY=

# Option B: Azure OpenAI (uncomment and fill all three)
# AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=<your deployment name>

# Option C: OpenAI-compatible gateway such as LiteLLM (uncomment, plus OPENAI_API_KEY above)
# OPENAI_BASE_URL=https://<gateway-host>/v1
# OPENAI_MODEL=<gateway model name>

# Sampling temperature for GPT-4.1 (GPT-5 models always use their default)
OPENAI_TEMPERATURE=0.1
